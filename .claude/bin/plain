#!/usr/bin/env bash
# Follow the plain-English triage panels for a Claude Code session.
#
# Panels are keyed on the session's working directory, so with no arguments this
# follows the project you run it from — open a split in the same repo and it is
# already pointed at the right session. That is the whole answer to "which one does
# it follow when I have five terminals open": each pane follows its own project,
# and no pane can drift onto another session's output.
#
#   plain              follow this project (cwd), waiting if it hasn't spoken yet
#   plain tether       follow the project whose slug matches "tether"
#   plain -a           follow every project at once, with headers
#   plain -l           list projects with panels, newest first
#   plain -c           clear this project's panel history

set -uo pipefail
DIR="${PLAIN_DIR:-$HOME/.claude/plain}"
mkdir -p "$DIR"

slug_of() { printf '%s' "${1//\//-}"; }
pretty()  { printf '%s' "${1%.md}" | sed 's/^-Users-[^-]*-//; s/-/\//g'; }

list() {
  local found=0 f
  # shellcheck disable=SC2012 - ls -t is the point; names here never contain newlines
  for f in $(ls -t "$DIR"/*.md 2>/dev/null); do
    found=1
    printf '  %-42s %s\n' "$(pretty "$(basename "$f")")" \
      "$(date -r "$f" '+%b %-d %H:%M' 2>/dev/null)"
  done
  [[ $found -eq 0 ]] && echo "  (no panels yet)"
  return 0
}

case "${1:-}" in
  -l|--list) echo "Projects with panels:"; list; exit 0 ;;
  -a|--all)
    # shellcheck disable=SC2046
    exec tail -n 40 -f $(ls -t "$DIR"/*.md 2>/dev/null) ;;
  -c|--clear)
    target="$DIR/$(slug_of "$PWD").md"; : > "$target"
    echo "cleared $(pretty "$(basename "$target")")"; exit 0 ;;
  -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

if [[ -n "${1:-}" ]]; then
  match=$(ls -t "$DIR"/*.md 2>/dev/null | grep -i -- "$1" | head -1)
  if [[ -z "$match" ]]; then
    echo "No panel matching '$1'. Available:" >&2; list >&2; exit 1
  fi
  echo "▸ $(pretty "$(basename "$match")")"
  exec tail -n 40 -f "$match"
fi

target="$DIR/$(slug_of "$PWD").md"
if [[ ! -f "$target" ]]; then
  # Waiting silently here was the original behaviour and it was wrong: running
  # `plain` one directory up (or in any repo with no session) looked identical to
  # "the agent hasn't answered yet", so it waited forever and created a junk file
  # to wait on. Say which project this pane is for and what else is available;
  # then still wait, because opening the pane before the first answer is normal.
  echo "▸ no panels yet for $(pretty "$(basename "$target")")"
  if compgen -G "$DIR/*.md" >/dev/null; then
    echo "  Panels DO exist for these projects — run plain from one of them,"
    echo "  or: plain <name>   /   plain -a"
    list
  else
    echo "  No project has panels at all yet. Is the Stop hook wired in"
    echo "  ~/.claude/settings.json, and has a session started since?"
  fi
  echo "  Waiting here in case this session simply hasn't answered yet…"
fi
# -F (not -f) follows by name, so this picks the file up when the hook creates it
# and we never have to create an empty one ourselves.
exec tail -n 40 -F "$target"
